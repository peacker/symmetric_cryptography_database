{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://example.org/symmetric_primitives/mode_families.schema.json",
    "title": "Variable-Length Mode Families",
    "description": "A mode is a variable-length construction directly usable as a cryptographic algorithm (AEAD, hash, XOF, MAC, KDF, PBKDF, PRNG, key wrap, stream cipher, ...). Each family entry also carries its instances.",
    "type": "object",
    "required": [
        "version",
        "mode_families"
    ],
    "properties": {
        "version": {
            "type": "integer",
            "minimum": 1
        },
        "mode_families": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/family"
            }
        }
    },
    "$defs": {
        "characteristics": {
            "type": "object",
            "properties": {
                "block_size_bits": { "type": "integer", "minimum": 1 },
                "state_size_bits": { "type": "integer", "minimum": 1 },
                "key_size_bits": { "type": "integer", "minimum": 1 },
                "key_size_bits_min": { "type": "integer", "minimum": 1 },
                "key_size_bits_max": { "type": "integer", "minimum": 1 },
                "nonce_size_bits": { "type": "integer", "minimum": 0 },
                "nonce_size_bits_min": { "type": "integer" },
                "nonce_size_bits_max": { "type": "integer" },
                "iv_size_bits": { "type": "integer", "minimum": 1 },
                "tag_size_bits": { "type": "integer", "minimum": 1 },
                "tag_size_bits_min": { "type": "integer", "minimum": 1 },
                "tag_size_bits_max": { "type": "integer", "minimum": 1 },
                "rate_bits": { "type": "integer" },
                "capacity_bits": { "type": "integer" },
                "rounds": { "type": "integer", "minimum": 1 },
                "output_size_bits": { "type": "integer", "minimum": 1 },
                "output_size_bits_min": { "type": "integer" },
                "output_size_bits_max": { "type": "integer" },
                "personalization": { "type": "boolean" },
                "components": {
                    "type": "array",
                    "items": { "$ref": "family_common.schema.json#/$defs/component_ref" }
                }
            },
            "additionalProperties": true
        },
        "instance": {
            "type": "object",
            "required": ["id", "name", "type", "characteristics"],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 },
                "reference_ids": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                },
                "characteristics": { "$ref": "#/$defs/characteristics" },
                "notes": { "type": "string" }
            },
            "additionalProperties": false
        },
        "family": {
            "type": "object",
            "required": [
                "id",
                "name",
                "construction_ids",
                "target_applications",
                "reference_ids",
                "process_participations",
                "influences",
                "notes",
                "instances"
            ],
            "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "construction_ids": {
                    "type": "array",
                    "items": { "$ref": "family_common.schema.json#/$defs/construction_id" }
                },
                "round_ids": {
                    "type": "array",
                    "items": { "$ref": "family_common.schema.json#/$defs/round_id" }
                },
                "target_applications": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                },
                "characteristics": { "$ref": "#/$defs/characteristics" },
                "innovative_ideas": {
                    "type": "array",
                    "items": { "$ref": "family_common.schema.json#/$defs/innovative_idea" }
                },
                "reference_ids": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                },
                "process_participations": {
                    "type": "array",
                    "items": { "$ref": "family_common.schema.json#/$defs/process_participation" }
                },
                "influences": {
                    "type": "array",
                    "items": { "$ref": "family_common.schema.json#/$defs/influence" }
                },
                "notes": { "type": "string", "minLength": 1 },
                "authors": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                },
                "year": { "type": "integer" },
                "underlying_primitive_ids": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                },
                "instances": {
                    "type": "array",
                    "minItems": 1,
                    "items": { "$ref": "#/$defs/instance" }
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
